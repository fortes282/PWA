# ─── Přístav Radosti — Environment Variables ──────────────────────────────────
# Copy this file to .env.production and fill in all required values.
#
# MUST #4 — PostgreSQL migration:
#   Set DATABASE_URL to enable PostgreSQL.
#   If DATABASE_URL is not set, the API falls back to SQLite (dev/staging only).

# ── PostgreSQL (MUST #4) ──────────────────────────────────────────────────────
# Required when using PostgreSQL (production recommended).
POSTGRES_DB=pristav
POSTGRES_USER=pristav
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# DATABASE_URL is auto-constructed from POSTGRES_* vars in docker-compose.yml.
# Set it explicitly here only if using an external/managed PG instance:
# DATABASE_URL=postgresql://pristav:password@localhost:5432/pristav

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME

# ── Auth / login rate limit (POST /auth/login, per IP) ───────────────────────
# Default v kódu: 10 požadavků / 5 min. Pro staging / Playwright proti deployi zvaž vyšší MAX.
# AUTH_LOGIN_RATE_LIMIT_MAX=120
# AUTH_LOGIN_RATE_LIMIT_WINDOW=5 minutes

# ── Application ───────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://pristav-radosti.cz
NEXT_PUBLIC_API_URL=https://pristav-radosti.cz/api

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS (SMSAPI) ──────────────────────────────────────────────────────────────
SMSAPI_TOKEN=
SMSAPI_SENDER=Pristav

# ── Push (VAPID) ──────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@pristav-radosti.cz
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── FIO Bank ──────────────────────────────────────────────────────────────────
FIO_API_KEY=

# ── Reminders ─────────────────────────────────────────────────────────────────
REMINDER_HOURS=24
