# ─── Přístav Radosti — Environment Variables ──────────────────────────────────
# Copy this file to .env.production and fill in all required values.
#
# MUST #4 — PostgreSQL migration:
#   Set DATABASE_URL to enable PostgreSQL.
#   If DATABASE_URL is not set, the API falls back to SQLite (dev/staging only).

# ── PostgreSQL (MUST #4) ──────────────────────────────────────────────────────
# Required when using PostgreSQL (production recommended).
POSTGRES_DB=pristav
POSTGRES_USER=pristav
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# DATABASE_URL is auto-constructed from POSTGRES_* vars in docker-compose.yml.
# Set it explicitly here only if using an external/managed PG instance:
# DATABASE_URL=postgresql://pristav:password@localhost:5432/pristav

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
HEALTH_DATA_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# ── Auth / login rate limit (POST /auth/login, per IP) ───────────────────────
# Default v kódu: 10 požadavků / 5 min. Pro staging / Playwright proti deployi zvaž vyšší MAX.
# AUTH_LOGIN_RATE_LIMIT_MAX=120
# AUTH_LOGIN_RATE_LIMIT_WINDOW=5 minutes
# AUTH_REFRESH_TOKEN_DAYS=30
# PUBLIC_BOOKING_RATE_LIMIT_MAX=8
# PUBLIC_BOOKING_RATE_LIMIT_WINDOW=10 minutes

# ── Slot Recovery (autonomous cancelled-slot outreach) ────────────────────────
# SLOT_RECOVERY_ENABLED=true
# SLOT_RECOVERY_MODE=full-auto
# SLOT_RECOVERY_BATCH_SIZE=25
# SLOT_RECOVERY_OFFER_EXPIRATION_MIN=20
# SLOT_RECOVERY_DISCOUNT_HOURS=12
# SLOT_RECOVERY_PUSH_ONLY=true
# SLOT_RECOVERY_MAX_OFFERS_PER_EVENT=6
# SLOT_RECOVERY_MAX_OFFERS_PER_CLIENT_DAY=4
# SLOT_RECOVERY_CLIENT_COOLDOWN_HOURS=6
# SLOT_RECOVERY_DEFAULT_DISCOUNT_PERCENT=20
# SLOT_RECOVERY_MAX_DISCOUNT_PERCENT=30

# ── Playwright E2E proti nasazené URL (viz PWA_TEST_MATRIX.md §8) ───────────
# Tyto proměnné docker-compose předává do kontejneru api (JWT_EXPIRES_IN, CI).
# CI=true výrazně zvedne limit loginu v API; JWT_EXPIRES_IN=2h aby token přežil ~13 min běh.
# CI=true
# JWT_EXPIRES_IN=2h
# AUTH_LOGIN_RATE_LIMIT_MAX=1000

# ── Application ───────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://pristav-radosti.cz
NEXT_PUBLIC_API_URL=https://pristav-radosti.cz/api

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── SMS (SMSAPI) ──────────────────────────────────────────────────────────────
SMSAPI_TOKEN=
SMSAPI_SENDER=Pristav

# ── Push (VAPID) ──────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@pristav-radosti.cz
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── FIO Bank ──────────────────────────────────────────────────────────────────
FIO_API_KEY=

# ── Reminders ─────────────────────────────────────────────────────────────────
REMINDER_HOURS=24
